#!/usr/bin/env python3
"""Compare the live ROS graph with contract.yaml.

Fails (exit 1) when a /robot/* topic (or a registered firmware/external topic) is published
with a type that differs from the contract, or when a /robot/* topic exists that is
not registered at all. The hidden topics of a registered action count as registered.
`--require` additionally fails for registered topics nobody publishes: `all` = every
topic that does not need the robot hardware (what the sim integration test can
expect), `everything` = every registered topic.

Run on a robot (inside any domain container):  ros2 run eurobot_common contract_check
"""
import argparse
import fnmatch
import os
import sys
import time

import rclpy
import yaml
from ament_index_python.packages import get_package_share_directory


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('--wait', type=float, default=3.0, help='seconds of discovery before checking')
    ap.add_argument('--require', nargs='*', default=[], metavar='TOPIC',
                    help='topics that must have a publisher, or "all" (except hardware: true) '
                         'or "everything"')
    ap.add_argument('--domains', default='', metavar='D1,D2',
                    help='check only what these domains own: topics they publish (and "*") '
                         'and unregistered topics in their areas (/robot/<area>/, owners from '
                         'contract.yaml, plus /robot/<domain>/); default: everything')
    ap.add_argument('--ignore', default='', metavar='P1,P2',
                    help='unregistered topics to leave alone (fnmatch patterns): the topics of '
                         'systems outside DIT-X on this robot, e.g. a web dashboard')
    a = ap.parse_args()
    domains = {d for d in a.domains.split(',') if d}
    ignore = [p for p in a.ignore.split(',') if p]

    def owned(t):
        return not domains or t.get('publisher') == '*' or t.get('publisher') in domains

    def area(name):
        # /robot/<area>/<thing> -> <area>; None for top-level names (firmware/external)
        parts = name.split('/')
        return parts[2] if name.startswith('/robot/') and len(parts) > 3 else None

    path = os.path.join(get_package_share_directory('eurobot_common'), 'contract.yaml')
    with open(path, encoding='utf-8') as f:
        c = yaml.safe_load(f)
    registered = {t['name']: t['type'] for t in c['topics'].values()}
    for act in (c.get('actions') or {}).values():
        # an action is a set of hidden topics (+ services, not checked here)
        pkg, _, name = act['type'].split('/')
        registered[act['name'] + '/_action/feedback'] = f'{pkg}/action/{name}_FeedbackMessage'
        registered[act['name'] + '/_action/status'] = 'action_msgs/msg/GoalStatusArray'
    fixed_names = {
        t['name'] for t in c['topics'].values() if t.get('firmware') or t.get('external')
    }

    rclpy.init()
    node = rclpy.create_node('contract_check')
    deadline = time.monotonic() + a.wait
    while time.monotonic() < deadline:
        rclpy.spin_once(node, timeout_sec=0.1)
    live = dict(node.get_topic_names_and_types())

    # who owns each /robot/<area>/ (startup -> main, system -> *); a domain also owns its own
    # name, so a new topic under /robot/<domain>/ is caught before it is registered
    area_owners = {}
    for t in c['topics'].values():
        area_owners.setdefault(area(t['name']), set()).add(t.get('publisher'))

    def mine(name):
        owners = area_owners.get(area(name), set()) | {area(name)}
        return '*' in owners or bool(owners & domains)

    problems = []
    for name, types in sorted(live.items()):
        if not name.startswith('/robot/') and name not in fixed_names:
            continue
        if domains and name not in registered and not mine(name):
            continue  # someone else's area (another domain, or a stack outside DIT-X)
        if name not in registered and any(fnmatch.fnmatchcase(name, p) for p in ignore):
            continue  # declared foreign on this robot (robots.ini foreign_topics)
        if name not in registered:
            problems.append(f'unregistered topic {name} {types}')
        elif types != [registered[name]]:
            problems.append(f'type mismatch on {name}: live {types}, contract {registered[name]}')
    if a.require == ['everything']:
        required = [t['name'] for t in c['topics'].values() if owned(t)]
    elif a.require == ['all']:
        required = [t['name'] for t in c['topics'].values() if owned(t) and not t.get('hardware')]
    else:
        required = a.require
    for name in required:
        if name not in live or not node.get_publishers_info_by_topic(name):
            problems.append(f'no publisher on {name}')

    for p in problems:
        print(f'FAIL  {p}')
    print(f'{"FAIL" if problems else "OK"}    {len(live)} topics checked against {path}')
    node.destroy_node()
    rclpy.shutdown()
    sys.exit(1 if problems else 0)


if __name__ == '__main__':
    main()
